{
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint site/js/",
    "lint:css": "stylelint site/css/**/*.css",
    "lint:py": "uvx ruff check .",
    "test:frontend": "node --test --test-concurrency=1 tests/frontend/app.e2e.test.mjs",
    "test:unit": "node --test tests/frontend/*.unit.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "visual:indicators": "node tools/capture_indicator_visuals.mjs --out=.scratch/indicator-visuals",
    "validate:contracts": "python tools/validate_deprecated_contracts.py && python tools/validate_data_schema.py && node tools/validate_domain_contracts.mjs",
    "validate:modules": "node tools/validate_module_graph.mjs",
    "test:py": "uv run --with pytest --with azure-functions pytest api/tests/ -v"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3"
  }
}
