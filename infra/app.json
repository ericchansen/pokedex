              "type": "string",
              "metadata": {
                "description": "GitHub branch"
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Resource tags"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('swaName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "properties": {
                "repositoryUrl": "[format('https://github.com/{0}/{1}', parameters('repoOwner'), parameters('repoName'))]",
                "branch": "[parameters('repoBranch')]",
                "buildProperties": {
                  "appLocation": "site",
                  "apiLocation": "api",
                  "outputLocation": "",
                  "skipGithubActionWorkflowGeneration": true
                }
              }
