      ]
    }
  ],
  "outputs": {
    "swaDefaultHostname": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', format('swa-{0}', parameters('swaName'))), '2025-04-01').outputs.defaultHostname.value]"
    },
    "swaResourceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', format('swa-{0}', parameters('swaName'))), '2025-04-01').outputs.resourceId.value]"
