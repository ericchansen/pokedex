    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('swa-{0}', parameters('swaName'))]",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "swaName": {
            "value": "[parameters('swaName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "repoOwner": {
            "value": "[parameters('repoOwner')]"
          },
          "repoName": {
            "value": "[parameters('repoName')]"
          },
          "repoBranch": {
            "value": "[parameters('repoBranch')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "872627643496439999"
            }
          },
          "parameters": {
            "swaName": {
              "type": "string",
              "metadata": {
                "description": "SWA resource name"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region"
              }
            },
            "repoOwner": {
              "type": "string",
              "metadata": {
                "description": "GitHub repo owner"
              }
            },
